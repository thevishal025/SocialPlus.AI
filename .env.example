# ================================================================
# SocialPlus.ai Environment Configuration
# ================================================================

# Application
APP_NAME=SocialPlus.ai
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Database (SQLite default, PostgreSQL ready: postgresql+psycopg2://user:pass@host/db)
DATABASE_URL=sqlite:///./socialplus.db

# YouTube Data API v3
# Obtain from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Meta Graph API (Instagram Professional & Facebook Pages)
# Obtain from: https://developers.facebook.com/apps/
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback
META_API_VERSION=v20.0

# NLP / AI Engine Configuration
MODEL_NAME=local-multilingual-ensemble
MAX_COMMENTS_DEFAULT=500
MAX_UPLOAD_SIZE_MB=25

